 "cells": [
  {
   "cell_type": "markdown",
   "id": "23725f4c",
   "metadata": {},
   "source": [
    "# NLP Practical 4 — Text Preprocessing Pipeline\n",
    "\n",
   ]
  },
  {
   "cell_type": "markdown",
   "id": "34ef335f",
   "metadata": {},
   "source": [
    "## 1. Install and import libraries"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "55f85112",
   "metadata": {},
   "outputs": [],
   "source": [
    "!pip -q install nltk spacy\n",
    "!python -m spacy download en_core_web_sm -q\n",
    "\n",
    "import nltk\n",
    "import spacy\n",
    "\n",
    "nltk.download('punkt')\n",
    "nltk.download('punkt_tab')\n",
    "nltk.download('stopwords')\n",
    "nltk.download('wordnet')\n",
    "nltk.download('omw-1.4')\n",
    "nltk.download('averaged_perceptron_tagger')\n",
    "nltk.download('averaged_perceptron_tagger_eng')\n",
    "\n",
    "from nltk.tokenize import word_tokenize\n",
    "from nltk.corpus import stopwords\n",
    "from nltk.stem import PorterStemmer, WordNetLemmatizer\n",
    "from nltk import pos_tag\n",
    "\n",
    "nlp = spacy.load(\"en_core_web_sm\")\n",
    "\n",
    "print(\"Libraries and model loaded successfully.\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9d6c563f",
   "metadata": {},
   "source": [
    "## 2. Sample text"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "618c5c67",
   "metadata": {},
   "outputs": [],
   "source": [
    "text = '''\n",
    "Natural Language Processing allows computers to understand human language.\n",
    "The students are studying different NLP techniques and building useful applications.\n",
    "They were learning about tokenization, stemming, and lemmatization.\n",
    "''' \n",
    "\n",
    "print(text)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "9a0ea453",
   "metadata": {},
   "source": [
    "## 3. Tokenization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cb12047f",
   "metadata": {},
   "outputs": [],
   "source": [
    "tokens = word_tokenize(text)\n",
    "\n",
    "print(\"Tokens:\")\n",
    "print(tokens)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "02df0c67",
   "metadata": {},
   "source": [
    "## 4. Lowercasing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "48e987d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "lower_tokens = [token.lower() for token in tokens]\n",
    "\n",
    "print(\"Lowercased tokens:\")\n",
    "print(lower_tokens)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "02d8f1b1",
   "metadata": {},
   "source": [
    "## 5. Stopword removal"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "0c0229b9",
   "metadata": {},
   "outputs": [],
   "source": [
    "stop_words = set(stopwords.words('english'))\n",
    "\n",
    "filtered_tokens = [\n",
    "    token for token in lower_tokens\n",
    "    if token.isalpha() and token not in stop_words\n",
    "]\n",
    "\n",
    "print(\"After stopword removal:\")\n",
    "print(filtered_tokens)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "5639af13",
   "metadata": {},
   "source": [
    "## 6. Stemming"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "90738572",
   "metadata": {},
   "outputs": [],
   "source": [
    "stemmer = PorterStemmer()\n",
    "\n",
    "stems = [stemmer.stem(token) for token in filtered_tokens]\n",
    "\n",
    "print(\"Stemmed words:\")\n",
    "print(stems)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "528db251",
   "metadata": {},
   "source": [
    "## 7. Lemmatization"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "5a50ba5a",
   "metadata": {},
   "outputs": [],
   "source": [
    "lemmatizer = WordNetLemmatizer()\n",
    "\n",
    "lemmas = [lemmatizer.lemmatize(token) for token in filtered_tokens]\n",
    "\n",
    "print(\"Lemmatized words:\")\n",
    "print(lemmas)"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "b93429dc",
   "metadata": {},
   "source": [
    "## 8. PoS tagging"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "69c5fbba",
   "metadata": {},
   "outputs": [],
   "source": [
    "pos_tags = pos_tag(filtered_tokens)\n",
    "\n",
    "print(\"Part-of-Speech tags:\")\n",
    "for word, tag in pos_tags:\n",
    "    print(f\"{word:20} {tag}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "0574cd7f",
   "metadata": {},
   "source": [
    "## 9. spaCy preprocessing and PoS tagging"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "09089f1e",
   "metadata": {},
   "outputs": [],
   "source": [
    "doc = nlp(text)\n",
    "\n",
    "print(f\"{'TOKEN':20} {'LEMMA':20} {'POS':10} {'TAG':10}\")\n",
    "print(\"-\" * 65)\n",
    "\n",
    "for token in doc:\n",
    "    if not token.is_space:\n",
    "        print(f\"{token.text:20} {token.lemma_:20} {token.pos_:10} {token.tag_:10}\")"
   ]
  }
 ],
